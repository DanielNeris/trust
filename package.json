{
  "name": "trust",
  "version": "1.0.0",
  "description": "How a P2P network trusts a peer, a block and a node without a blockchain: challenge-response, signed Merkle logs, fork proofs and address-derived DHT ids",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/*.test.js\"",
    "demo": "node example/demo.js",
    "sim": "node sim/grind.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "author": "Daniel Neris",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
